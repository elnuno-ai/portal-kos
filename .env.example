# Connection string Postgres (Neon / Supabase / Vercel Postgres).
# Di Vercel, POSTGRES_URL juga didukung otomatis untuk Vercel Postgres.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Web Push (banner notifikasi). Buat dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Kunci untuk tombol kirim banner di Panel Admin (isi bebas, samakan di kartu push).
PUSH_ADMIN_TOKEN=
